	cell_fall(scalar) {
          values("0.67117");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0046;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.17960");
	}
	fall_constraint(scalar) {
          values("-0.09038");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
