	cell_fall(scalar) {
          values("0.47443");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0047;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.14148");
	}
	fall_constraint(scalar) {
          values("-0.03900");
	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
