          values("1.01612");
	}
      }
    }
    pin("i_rst_n") {
      direction : input;
      capacitance : 0.0044;
      timing() {
        related_pin : "i_clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.23194");
	}
	fall_constraint(scalar) {
          values("-0.19753");
	}
      }
      timing() {
        related_pin : "i_clk";
