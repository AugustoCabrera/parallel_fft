	}
      }
      timing() {
        related_pin : "i_clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("-0.21290");
	}
	fall_constraint(scalar) {
          values("-0.23081");
	}
      }
    }
    pin("i_spi_mosi") {
      direction : input;
      capacitance : 0.0044;
    }
