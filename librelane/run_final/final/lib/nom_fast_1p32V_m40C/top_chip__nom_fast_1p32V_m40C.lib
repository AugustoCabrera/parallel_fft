      capacitance : 0.1082;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.38459");
	}
	cell_fall(scalar) {
          values("0.37630");
	}
      }
